# Backend Environment Variables
# Copy this file to ".env" and fill in your values. Never commit ".env".

# MongoDB connection string
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# JWT signing secret — generate a long random string
JWT_SECRET=change-me-to-a-long-random-string

# Port for the Express server (default: 3002)
PORT=3002

# URL of the ML FastAPI service (default: http://127.0.0.1:8000)
ML_SERVICE_URL=http://127.0.0.1:8000
